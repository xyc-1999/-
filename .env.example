# ============================================================
#  enterprise-agent-system  环境变量模板
#  复制为 .env 并填入真实值：
#     cp .env.example .env        (Linux/macOS)
#     Copy-Item .env.example .env (Windows PowerShell)
#  docker-compose 与后端(Python)都会读取本项目根目录的 .env
# ============================================================

# ---------- 应用 ----------
APP_NAME=enterprise-agent-system
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# 后端服务端口
BACKEND_PORT=8900
API_V1_PREFIX=/api/v1

# ---------- LLM (DeepSeek) ----------
# 使用 DeepSeek API Key（OpenAI 兼容协议）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
# DeepSeek 官方端点；兼容 OpenAI SDK，末尾带 /v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 聊天模型：deepseek-chat（通用） / deepseek-reasoner（推理）
LLM_CHAT_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ---------- Embedding (向量嵌入) ----------
# DeepSeek 无 embedding 接口，向量检索由独立供应商承担。
#   dashscope(默认)      : 通义 Qwen 模型（qwen3.7-text-embedding-flash）
#   openai              : OpenAI 官方 embedding
#   sentence_transformers: 本地模型（离线可用）
EMBEDDING_PROVIDER=dashscope
# DashScope(通义千问) API Key —— 阿里云百炼平台申请
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
# DashScope OpenAI 兼容端点
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen 嵌入模型
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 仅当 EMBEDDING_PROVIDER=sentence_transformers 时使用（本地 HF 模型）
EMBEDDING_HF_MODEL=BAAI/bge-m3

# ---------- 知识库文档入库 ----------
# 源文档目录（.txt/.md/.pdf，递归扫描）
KB_DOCS_DIR=./backend/data/documents
# 分片参数
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1        # docker 内为避免端口冲突可改为 mysql
MYSQL_PORT=3306
# 此账号用于 docker mysql 容器创建的业务账号(见 compose)
MYSQL_USER=agent
MYSQL_PASSWORD=agent123456
MYSQL_DB=enterprise_agent
# 注意：compose 中 MYSQL_ROOT_PASSWORD 复用了 MYSQL_PASSWORD，
# 生产环境应单独加密保管并区分 ROOT 与业务账号

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=agent123456
REDIS_DB=0

# ---------- ChromaDB (向量库) ----------
# 内嵌模式(默认)：向量持久化到 backend/data/chroma
CHROMA_PERSIST_DIR=./backend/data/chroma
CHROMA_COLLECTION=enterprise_documents
# 若要使用独立 Chroma Server，取消注释并配置：
# CHROMA_HOST=chroma
# CHROMA_PORT=8000

# ---------- 会话 / 记忆 ----------
# 会话记忆 TTL（秒）
SESSION_TTL_SECONDS=604800
# 记忆窗口保留最近消息数
MEMORY_WINDOW_MESSAGES=20
# 向量检索返回条数
TOP_K_VECTOR_RETRIEVAL=4

# ---------- 鉴权 / CORS ----------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000

# ---------- MCP ----------
MCP_CONFIG_PATH=./backend/mcp_servers/config.yaml